{
	"name": "@luolapeikko/async-lock",
	"version": "0.0.1",
	"description": "Async lock implementation",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		"import": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"require": {
			"types": "./dist/index.d.cts",
			"default": "./dist/index.cjs"
		},
		"default": "./dist/index.mjs"
	},
	"scripts": {
		"build": "tsdown src/index.ts --sourcemap --format cjs,esm --dts --clean",
		"prepublishOnly": "npm run test && npm run build",
		"test": "vitest test --run --no-isolate --coverage",
		"coverage": "vitest test --run --no-isolate --reporter=dot --coverage --coverage.reporter=lcov",
		"lint": "biome check",
		"validate": "tsc --noEmit"
	},
	"keywords": [
		"pin",
		"personid"
	],
	"files": [
		"dist"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/luolapeikko/async-lock.git"
	},
	"author": "mharj",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/luolapeikko/async-lock/issues"
	},
	"homepage": "https://github.com/luolapeikko/async-lock#readme",
	"devDependencies": {
		"@avanio/logger-like": "^0.2.13",
		"@biomejs/biome": "^2.5.15",
		"@types/node": "^24.19.2",
		"@vitest/coverage-v8": "^5.0.5",
		"async-mutex": "^0.5.0",
		"c8": "^12.0.0",
		"source-map-support": "^0.5.21",
		"tsdown": "^0.23.1",
		"tslib": "^2.8.1",
		"typescript": "^7.0.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.5",
		"zod": "^4.6.7"
	},
	"peerDependencies": {
		"@avanio/logger-like": "^0.2.10",
		"async-mutex": "^0.5.0"
	},
	"packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d"
}
