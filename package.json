{
    "name": "@luolapeikko/async-lock",
    "version": "0.0.1",
    "description": "Async lock implementation",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "require": "./dist/index.js",
            "import": "./dist/index.mjs"
        }
    },
    "scripts": {
        "build": "tsup src/index.ts --sourcemap --format cjs,esm --dts --clean",
        "prepublishOnly": "npm run test && npm run build",
        "test": "vitest test --run --no-isolate --coverage",
        "coverage": "vitest test --run --no-isolate --reporter=dot --coverage --coverage.reporter=lcov",
        "lint": "eslint . --ext .ts",
        "validate": "tsc --noEmit"
    },
    "keywords": [
        "pin",
        "personid"
    ],
    "files": [
        "dist"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/luolapeikko/async-lock.git"
    },
    "author": "mharj",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/luolapeikko/async-lock/issues"
    },
    "homepage": "https://github.com/luolapeikko/async-lock#readme",
    "devDependencies": {
        "@avanio/logger-like": "^0.2.12",
        "@cspell/eslint-plugin": "^8.18.0",
        "@eslint/js": "^9.23.0",
        "@stylistic/eslint-plugin": "^4.2.0",
        "@stylistic/eslint-plugin-ts": "^4.2.0",
        "@types/node": "^22.13.14",
        "@typescript-eslint/eslint-plugin": "^8.28.0",
        "@typescript-eslint/parser": "^8.28.0",
        "@vitest/coverage-v8": "^3.0.9",
        "async-mutex": "^0.5.0",
        "c8": "^10.1.3",
        "eslint": "^9.23.0",
        "eslint-config-prettier": "^10.1.1",
        "eslint-import-resolver-typescript": "^4.2.5",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-jsdoc": "^50.6.9",
        "eslint-plugin-prettier": "^5.2.5",
        "eslint-plugin-sonarjs": "^3.0.2",
        "source-map-support": "^0.5.21",
        "tslib": "^2.8.1",
        "tsup": "^8.4.0",
        "typescript": "^5.8.2",
        "typescript-eslint": "^8.28.0",
        "vite": "^6.2.3",
        "vitest": "^3.0.9",
        "zod": "^3.24.2"
    },
    "peerDependencies": {
        "@avanio/logger-like": "^0.2.10",
        "async-mutex": "^0.5.0"
    },
    "packageManager": "pnpm@9.12.3+sha512.cce0f9de9c5a7c95bef944169cc5dfe8741abfb145078c0d508b868056848a87c81e626246cb60967cbd7fd29a6c062ef73ff840d96b3c86c40ac92cf4a813ee"
