{
	"name": "@luolapeikko/async-lock",
	"version": "0.0.1",
	"description": "Async lock implementation",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		"import": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"require": {
			"types": "./dist/index.d.cts",
			"default": "./dist/index.cjs"
		},
		"default": "./dist/index.mjs"
	},
	"scripts": {
		"build": "tsdown src/index.ts --sourcemap --format cjs,esm --dts --clean",
		"prepublishOnly": "npm run test && npm run build",
		"test": "vitest test --run --no-isolate --coverage",
		"coverage": "vitest test --run --no-isolate --reporter=dot --coverage --coverage.reporter=lcov",
		"lint": "biome check",
		"validate": "tsc --noEmit"
	},
	"keywords": [
		"pin",
		"personid"
	],
	"files": [
		"dist"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/luolapeikko/async-lock.git"
	},
	"author": "mharj",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/luolapeikko/async-lock/issues"
	},
	"homepage": "https://github.com/luolapeikko/async-lock#readme",
	"devDependencies": {
		"@avanio/logger-like": "^0.2.12",
		"@biomejs/biome": "^2.4.14",
		"@types/node": "^24.12.2",
		"@vitest/coverage-v8": "^4.1.5",
		"async-mutex": "^0.5.0",
		"c8": "^11.0.0",
		"source-map-support": "^0.5.21",
		"tsdown": "^0.21.10",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"vitest": "^4.1.5",
		"zod": "^4.4.3"
	},
	"peerDependencies": {
		"@avanio/logger-like": "^0.2.10",
		"async-mutex": "^0.5.0"
	},
	"packageManager": "pnpm@10.33.3+sha512.a19744364a7e248b92657a4ca5973f9354d21caf982579674b1c539f32c7420c47138ad8b1254df07aba9bc782d9b3029e3db34d5dbff974326eb74dac8ff489"
}
